#!/usr/bin/env bash
# PreToolUse(Bash(git commit*)) hook — enforce vault sync before every commit.
#
# Behavior:
#   1. Auto-stages any modified vault/ files so they're always in the commit.
#   2. Blocks the commit if no session note exists for today, instructing Claude
#      to write one first.
#   3. Lets the commit through the normal permission flow once a session note
#      is present.
#
# Output uses hookSpecificOutput.permissionDecision; the top-level "decision"
# field is not supported for PreToolUse.
set -euo pipefail

# The settings entry carries an "if": "Bash(git commit*)" filter, but Claude
# Code does not always honor it, and then this hook fires on every Bash call.
# So the hook checks the command itself and stays silent for anything that is
# not a git commit; otherwise it would stage vault/ and block unrelated commands.
HOOK_INPUT="$(cat 2>/dev/null || true)"
IS_COMMIT="$(printf '%s' "$HOOK_INPUT" | python3 -c 'import json,re,sys
try:
    cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
except Exception:
    cmd = ""
print("yes" if re.search(r"(^|[;&|(]\s*)git(\s+-[cC]\s+\S+)*\s+commit(\s|$)", cmd) else "no")' 2>/dev/null || echo no)"
[[ "$IS_COMMIT" == "yes" ]] || exit 0

TODAY="$(date +%Y-%m-%d)"

find_vault() {
  local dir="${1:-$PWD}"
  while [[ "$dir" != "/" ]]; do
    [[ -f "$dir/vault/.vault-meta.json" ]] && echo "$dir/vault" && return
    dir="$(dirname "$dir")"
  done
  return 1
}

VAULT="$(find_vault "$PWD" 2>/dev/null)" || exit 0
REPO_ROOT="$(dirname "$VAULT")"

# Auto-stage any unstaged vault changes so they land in this commit
cd "$REPO_ROOT"
UNSTAGED="$(git diff --name-only -- vault/ 2>/dev/null || true)"
UNTRACKED="$(git ls-files --others --exclude-standard vault/ 2>/dev/null || true)"
if [[ -n "$UNSTAGED" || -n "$UNTRACKED" ]]; then
  git add vault/
fi

# Block if no session note for today
SESSION_FILE="$VAULT/sessions/$TODAY.md"
if [[ ! -f "$SESSION_FILE" ]] || ! grep -q "^## " "$SESSION_FILE" 2>/dev/null; then
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"No session note for %s. Write a brief session entry to vault/sessions/%s.md (use vault/templates/session.md — what changed, what is left open), stage it, then commit. The vault will be included in the commit automatically."}}' \
    "$TODAY" "$TODAY"
  exit 0
fi

# Context only, no permissionDecision: an "allow" here would skip the user's
# permission prompt for git commit, and commits should stay a conscious approval.
printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"Vault synced for %s — session note present, vault changes staged."}}' "$TODAY"
